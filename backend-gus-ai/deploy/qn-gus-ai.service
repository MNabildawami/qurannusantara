[Unit]
Description=QuranNusantara Gus AI FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qn-gus-ai
Group=qn-gus-ai
WorkingDirectory=/opt/qn-gus-ai
EnvironmentFile=/opt/qn-gus-ai/.env
ExecStart=/opt/qn-gus-ai/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/qn-gus-ai

[Install]
WantedBy=multi-user.target
