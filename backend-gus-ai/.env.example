# Obtain a key from https://openrouter.ai/keys
# Keep this secret on the VPS only. Never put it in NEXT_PUBLIC_* variables.
OPENROUTER_API_KEY=replace_with_your_openrouter_key

# Comma-separated allowed browser origins; add your exact Vercel production domain.
FRONTEND_ORIGINS=http://localhost:3000,https://qurannusantara.vercel.app

# Optional: appears as app attribution in OpenRouter.
OPENROUTER_SITE_URL=https://qurannusantara.vercel.app
